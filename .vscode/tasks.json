{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FreeCAD: 打开 Dob 底座总成 (DobAssembly)",
            "type": "shell",
            "command": "open",
            "args": [
                "-a",
                "FreeCAD",
                "${workspaceFolder}/cad/01_Dob/DobAssembly.FCStd"
            ],
            "problemMatcher": []
        },
        {
            "label": "FreeCAD: 启动（空文档）",
            "type": "shell",
            "command": "open",
            "args": [
                "-a",
                "FreeCAD"
            ],
            "problemMatcher": []
        },
        {
            "label": "导出目录: 在 Finder 中预览",
            "type": "shell",
            "command": "open",
            "args": [
                "${workspaceFolder}/exports"
            ],
            "problemMatcher": []
        },
        {
            "label": "FreeCAD: 监控并归档旧备份",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/src/tools/freecad_backup_monitor.py"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "detail": "每个 FCStd 同目录只保留最新 FCBak，其余移入项目根目录 backup；手动启动，Ctrl+C 停止。"
        }
    ]
}
